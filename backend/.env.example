# ============================================================================
# PMS Backend - Local Environment Template
# 复制为 .env 后填实际密码。.env 不入库。
# ============================================================================

# MySQL 应用账号（不要用 root！）
DB_APP_USER=pms_app
DB_APP_PASSWORD=Pms@App2026Secure

# MySQL root 密码（仅初次建库脚本用，应用运行时不用）
DB_ROOT_PASSWORD=

# JWT 签名密钥（生产环境务必换成强随机字符串，长度 ≥ 32）
JWT_SECRET=xkzoom-pms-dev-secret-please-change-in-production-32chars-min
JWT_EXPIRES_HOURS=24

# 服务端口
SERVER_PORT=8080
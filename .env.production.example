# Copy to .env.production and replace every CHANGE_ME value.
DB_APP_PASSWORD=CHANGE_ME_DATABASE_APP_PASSWORD
DB_ROOT_PASSWORD=CHANGE_ME_DATABASE_ROOT_PASSWORD
JWT_SECRET=CHANGE_ME_WITH_AT_LEAST_32_RANDOM_CHARACTERS
JWT_EXPIRES_HOURS=8
PMS_CHANNEL_SECRET_KEY=CHANGE_ME_WITH_AT_LEAST_32_RANDOM_CHARACTERS
PMS_ALLOWED_ORIGINS=https://pms.example.com
PMS_HTTP_PORT=8088
JAVA_TOOL_OPTIONS=-XX:MaxRAMPercentage=75.0 -XX:+UseG1GC
